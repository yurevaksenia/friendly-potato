<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WeldAvalonia.Views.MainWindow"
        Width="900"
        Height="600"
        MinWidth="640"
        MinHeight="420"
        Title="WeldAvalonia">
    <Grid RowDefinitions="Auto,*" Margin="24">
        <TextBlock FontSize="24"
                   FontWeight="SemiBold"
                   Text="WeldAvalonia" />
        <Border Grid.Row="1"
                Margin="0,20,0,0"
                Padding="24"
                BorderThickness="1"
                CornerRadius="8"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}">
            <StackPanel Spacing="8">
                <TextBlock FontSize="18"
                           Text="Open-source welding emissions calculator" />
                <TextBlock Opacity="0.7"
                           TextWrapping="Wrap"
                           Text="Initial Avalonia application shell. Calculation modules will be migrated incrementally." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
